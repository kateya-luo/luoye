FROM node:22-alpine AS web-builder
WORKDIR /build
COPY package.json ./
COPY apps/web-client/package.json ./apps/web-client/package.json
RUN npm config set registry https://registry.npmmirror.com
RUN npm install
COPY apps/web-client ./apps/web-client
RUN npm run build:web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /build/apps/web-client/dist /usr/share/nginx/html
# 录音卡交互演示（静态单页，供分享 http://host/card-sim/）
COPY apps/card-sim /usr/share/nginx/html/card-sim
EXPOSE 80
# HTTPS 阶段启用：EXPOSE 443
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
