# ClearMeeting v0.20.2
# 复制为 deploy/.env 后再启动。不要将 .env 、密码、token 或 API Key 提交到仓库。

# ---------- 发布与数据 ----------
SERVER_RELEASE=clearmeeting-server-v0.20.2
DEVICE_OFFLINE_ASR_WINDOW_MS=300000
OFFLINE_ASR_WORKERS=4
OFFLINE_ASR_LEASE_SECONDS=7200
OFFLINE_ASR_MAX_RETRIES=30
OFFLINE_ASR_RETRY_BASE_SECONDS=5
DATA_DIR=/app/data
LOG_LEVEL=INFO

# ---------- 网页账号 ----------
# 仅用于首次创建测试账号；账号已存在时，修改此值不会重置密码。
# 启动前替换占位符，不要在文档或聊天中传递真实值。
TEST_ACCOUNT_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# 账号 token 签名密钥。建议用 `openssl rand -hex 32` 生成。
# 若留空，服务端会生成并持久化到 SQLite meta；迁移数据库时必须一起迁移。
AUTH_SECRET=CHANGE_ME_WITH_64_HEX_CHARACTERS
AUTH_TOKEN_TTL_SECONDS=43200

# 逗号分隔、必须是完整 Origin（协议 + 主机 + 非默认端口），不带路径。
# 空值 = 仅同源；公网环境不得使用 *。下列为当前工程内外入口。
CORS_ALLOW_ORIGINS=http://192.168.31.183,http://clearmeeting.chat:34567

# ---------- 落叶设备 API v1 ----------
# 设备 token/nonce 摘要密钥。建议另用 `openssl rand -hex 32` 生成，不要与 AUTH_SECRET 相同。
# 若留空，服务端会生成并持久化到 SQLite meta。
DEVICE_API_SECRET=CHANGE_ME_WITH_ANOTHER_64_HEX_SECRET

# 一次性配对窗口、设备 token 寿命和网页在线判定窗口（秒）。
DEVICE_PAIRING_TTL_SECONDS=600
DEVICE_TOKEN_TTL_SECONDS=31536000
DEVICE_ONLINE_WINDOW_SECONDS=90
DEVICE_CLAIM_RATE_WINDOW_SECONDS=300
DEVICE_CLAIM_RATE_MAX_FAILURES=5
DEVICE_LIVE_ASR_START_TIMEOUT_SECONDS=5
DEVICE_LIVE_ASR_SEND_TIMEOUT_SECONDS=5

# 设备上传上限（字节）：单个录音分片 1 MiB，单个语音待办 4 MiB。
DEVICE_MAX_CHUNK_BYTES=1048576
DEVICE_MAX_TODO_BYTES=4194304

# v1 使用设备自生成的一次性配对码，不存在服务器全局 DEVICE_PAIR_CODE。

# ---------- AI / 转写 ----------
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

ASR_MODE=funasr
FUNASR_WS_URL=ws://funasr:10095

# 16 GiB/8 核无显卡服务器使用独立CPU整场定稿服务：5分钟窗口负责预览，
# 上传完成后对完整 .b.pcm 执行 VAD+ASR+时间戳+CAM++ 全局聚类。
FUNASR_OFFLINE_HTTP_URL=http://funasr-offline-cpu:10096
OFFLINE_HTTP_PREVIEW_TIMEOUT=900
OFFLINE_HTTP_FINALIZE_TIMEOUT=7200
# 未启用 offline-asr-cpu profile 时可删除 HTTP URL，回退旧WebSocket预览链路；
# 但设备完整定稿需要HTTP服务。
# FUNASR_OFFLINE_WS_URL=ws://funasr-offline-cpu:10095
# OFFLINE_ASR_MODE=2pass
# GPU 试验环境才使用 ws://funasr-offline:10095 + offline；当前生产不建议。
FUNASR_MODELS_DIR=../../funasr-runtime-resources/models

# ---------- 说话人分离 ----------
SPEAKER_MODE=remote
SPEAKER_EMBEDDING_URL=http://speaker:10100/embed
SPEAKER_SIMILARITY_THRESHOLD=0.68
SPEAKER_CANDIDATE_SIMILARITY_THRESHOLD=0.72
SPEAKER_CANDIDATE_CONFIRMATIONS=2
SPEAKER_CANDIDATE_TTL_SEGMENTS=12
SPEAKER_CLUSTER_MERGE_THRESHOLD=0.78
SPEAKER_CLUSTER_MERGE_INTERVAL=20
SPEAKER_MIN_SEGMENT_SECONDS=2.0
SPEAKER_MAX_SEGMENT_SECONDS=12
SPEAKER_MIN_RMS=80
SPEAKER_REQUEST_TIMEOUT_SECONDS=20
SPEAKER_HEALTH_TIMEOUT_SECONDS=2
SPEAKER_SERVICE_MAX_SEGMENT_SECONDS=12
POST_MEETING_SPEAKER_THRESHOLD=0.68

# ---------- 可靠上传/会议调优 ----------
SESSION_RESUME_WINDOW_SECONDS=7200
ROLLING_SUMMARY_MIN_SEGMENTS=2
# Recorder-card meetings also flush a rolling draft when speech produces fewer
# final ASR segments than the threshold for this many seconds.
DEVICE_ROLLING_SUMMARY_MAX_WAIT_SECONDS=20
# Only a recorder-card session with a recent live audio packet is exposed as
# an active read-only web meeting. This hides abandoned `uploading` rows.
DEVICE_ACTIVE_SESSION_TTL_SECONDS=30
MEETING_END_AUDIO_WAIT_SECONDS=10
OFFLINE_IDLE_TIMEOUT=30
OFFLINE_FEED_CHUNK_MS=600
OFFLINE_FEED_PACE_MS=0
POST_MEETING_DIARIZATION_ENABLED=1
POST_MEETING_MAX_EMBEDDINGS=400
POST_MEETING_MAX_SEGMENT_SECONDS=12

# nginx 宿主机绑定；默认监听所有网卡。
HTTP_BIND=0.0.0.0
