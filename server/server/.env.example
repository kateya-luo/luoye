# ClearMeeting server v0.19.0 / luoye-device-api/2
# API/2 currently implements engineering device authentication only.  Do not set
# this to "factory" or "required": startup intentionally fails rather than
# claiming that an unimplemented factory signature check is active.
DEVICE_AUTH_PROFILE=engineering

# Generate independent high-entropy production values.
AUTH_SECRET=replace-with-at-least-48-random-characters
DEVICE_API_SECRET=replace-with-a-different-48-character-random-secret
TEST_ACCOUNT_PASSWORD=replace-before-first-database-start

CORS_ALLOW_ORIGINS=https://meeting.example.invalid
SERVER_RELEASE=clearmeeting-server-v2.0.0
DEVICE_OFFLINE_ASR_WINDOW_MS=600000
DATA_DIR=/data

DEVICE_PAIRING_TTL_SECONDS=600
DEVICE_TOKEN_TTL_SECONDS=31536000
DEVICE_ONLINE_WINDOW_SECONDS=90
DEVICE_MAX_CHUNK_BYTES=1048576
DEVICE_MAX_TODO_BYTES=4194304
DEVICE_CLAIM_RATE_WINDOW_SECONDS=300
DEVICE_CLAIM_RATE_MAX_FAILURES=5
DEVICE_LIVE_ASR_START_TIMEOUT_SECONDS=5
DEVICE_LIVE_ASR_SEND_TIMEOUT_SECONDS=5
